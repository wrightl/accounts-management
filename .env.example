# Copy to .env.local and fill in. Never commit real secrets.
# On Vercel these are provided by the Neon, Clerk and Blob integrations.

# --- Database (Neon) ---
# Pooled connection string for the app:
DATABASE_URL=
# Direct (non-pooled) connection string for migrations:
DATABASE_URL_UNPOOLED=

# --- Auth (Clerk) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# --- File storage (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=

# --- Email (pluggable; default "console" just logs) ---
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="Dot + Dash Accounts <accounts@dotanddashconsulting.com>"

# --- App ---
NEXT_PUBLIC_APP_URL=https://accounts.dotanddashconsulting.com

# --- Cron / automation (Phase 6) ---
# Shared secret for Vercel Cron Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
# Foundation flag for recurring invoice generation (default off)
RECURRING_INVOICES_ENABLED=false
