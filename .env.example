# Copy to .env.local and fill in. Never commit real secrets.
# On Vercel these are provided by the Neon, Clerk and Blob integrations.

# --- Database (Neon) ---
# Pooled connection string for the app:
DATABASE_URL=
# Direct (non-pooled) connection string for migrations:
DATABASE_URL_UNPOOLED=

# --- Auth (Clerk) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Local UI verification: `npm run auth:agent` mints a one-time sign-in URL for a
# tenant founder (development sk_test_ keys only). Optional: pass --email / --redirect.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/onboarding

# --- File storage (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=

# --- AI Gateway (optional — for receipt OCR when provider is ai_gateway) ---
AI_GATEWAY_API_KEY=

# --- Email (pluggable; default "console" just logs in local/dev) ---
# Production MUST use EMAIL_PROVIDER=resend — console throws in production.
EMAIL_PROVIDER=console
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM="Alfa by Dot+Dash <accounts@dotanddashconsulting.com>"
# Domain that accepts inbound expense emails (Resend Receiving MX).
# Shared with other apps; Alfa claims addresses by prefix.
# Addresses are {prefix}+{companySlug}.{userSlug}@{domain}
EXPENSE_INBOUND_DOMAIN=inbound.dotanddashconsulting.com
EXPENSE_INBOUND_PREFIX=alfa.expenses

# Optional break-glass /platform access (comma-separated emails). Unset = none.
# Bootstrap operators come from install-time data migrations (see src/db/data-migrations/).
# Later operators are invited from Platform → Users.
PLATFORM_ADMIN_EMAILS=

# --- Stripe Billing (manual account — not Vercel Marketplace) ---
# Create a UK Stripe account; paste restricted key + price IDs + webhook secret.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Set true only after UK VAT registration is active in Stripe Tax.
STRIPE_TAX_ENABLED=false

# --- App ---
NEXT_PUBLIC_APP_URL=https://alfa.dotanddashconsulting.com

# --- Cron / automation ---
# Required. Cron routes refuse to run if this is empty.
# Vercel Cron sends Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# --- Notifications ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@company.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=   # same as public key
FCM_PROJECT_ID=                 # optional, mobile push
FCM_SERVICE_ACCOUNT_JSON=       # optional