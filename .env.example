# Copy to .env.local and fill in. Never commit real secrets.
# On Vercel these are provided by the Neon, Clerk and Blob integrations.

# --- Database (Neon) ---
# Pooled connection string for the app:
DATABASE_URL=
# Direct (non-pooled) connection string for migrations:
DATABASE_URL_UNPOOLED=

# --- Auth (Clerk) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# --- File storage (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=

# --- AI Gateway (optional — for receipt OCR when provider is ai_gateway) ---
AI_GATEWAY_API_KEY=

# --- Email (pluggable; default "console" just logs) ---
EMAIL_PROVIDER=console
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM="Dot + Dash Accounts <accounts@dotanddashconsulting.com>"
# Domain that accepts inbound expense emails (Resend Receiving MX).
# Addresses are {prefix}+{companySlug}.{userSlug}@{domain}
EXPENSE_INBOUND_DOMAIN=dotanddashconsulting.com
EXPENSE_INBOUND_PREFIX=expenses

# First-login role bootstrap (comma-separated). Unset = the defaults below.
# Set to empty to disable bootstrap (everyone starts pending).
# `npm run db:seed` inserts these admin emails into `users` before first login.
BOOTSTRAP_ADMIN_EMAILS=lee@dotanddashconsulting.com
BOOTSTRAP_USER_EMAILS=angel@dotanddashconsulting.com

# --- App ---
NEXT_PUBLIC_APP_URL=https://accounts.dotanddashconsulting.com

# --- Cron / automation ---
# Required. Cron routes refuse to run if this is empty.
# Vercel Cron sends Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
# Foundation flag for recurring invoice generation (default off)
RECURRING_INVOICES_ENABLED=false
