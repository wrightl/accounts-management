{
    "name": "ddapp",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev -p 3001",
        "build": "npm run db:migrate:deploy && next build",
        "db:migrate:deploy": "node ./scripts/migrate-on-build.mjs",
        "start": "next start",
        "lint": "eslint",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "node ./scripts/migrate-on-build.mjs",
        "db:seed": "tsx scripts/seed.ts",
        "promo:seed": "tsx scripts/seed-promo-demo.ts",
        "promo:record": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers tsx scripts/record-promo.ts",
        "promo:assemble": "node scripts/assemble-promo-video.mjs",
        "promo:all": "npm run promo:seed && npm run promo:record && npm run promo:assemble",
        "marketing:capture": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers tsx scripts/capture-marketing.ts",
        "marketing:capture:production": "PROMO_BASE_URL=https://accounts-manager.dotanddashconsulting.com PROMO_SEED_ALLOW_REMOTE=1 PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers tsx scripts/capture-marketing.ts",
        "marketing:capture:prod-local": "PROMO_BASE_URL=http://localhost:3002 PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers tsx scripts/capture-marketing.ts",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio",
        "tunnel": "ngrok http 3001 --log=stdout"
    },
    "dependencies": {
        "@clerk/nextjs": "^7.7.8",
        "@napi-rs/canvas": "^1.0.7",
        "@neondatabase/serverless": "^1.1.0",
        "@react-pdf/renderer": "^4.6.1",
        "@vercel/blob": "^2.8.0",
        "@vercel/functions": "^3.9.8",
        "ai": "^7.0.77",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "drizzle-orm": "^0.45.2",
        "lucide-react": "^1.33.0",
        "next": "16.3.1",
        "pdfjs-dist": "^6.2.108",
        "pg": "^8.23.0",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "recharts": "^3.10.1",
        "resend": "^6.20.0",
        "tailwind-merge": "^3.6.0",
        "tesseract.js": "^7.0.0",
        "ws": "^8.21.3",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@clerk/testing": "^2.2.28",
        "@electric-sql/pglite": "^0.5.5",
        "@playwright/test": "^1.62.1",
        "@tailwindcss/postcss": "^4",
        "@types/node": "^20",
        "@types/pg": "^8.23.1",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@types/ws": "^8.18.1",
        "dotenv": "^17.4.2",
        "drizzle-kit": "^0.31.10",
        "eslint": "^9",
        "eslint-config-next": "16.3.1",
        "ngrok": "^5.0.0-beta.2",
        "tailwindcss": "^4",
        "tsx": "^4.23.12",
        "typescript": "^5",
        "vitest": "^4.1.11"
    }
}
