# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/playwright/.cache

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
/test-results/
/playwright.local.config.ts

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!mobile/.env.example
!mobile/.env.development

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# bank export files
/.bank-exports

# promo video outputs (scripts + captions stay in repo)
/promo/output/
/promo/raw/
/promo/raw-marketing/
/promo/assets/
/promo/routes.json
/.playwright-browsers/

# marketing capture metadata (contains demo Clerk email)
/public/marketing/capture-meta.json
/public/marketing/product-tour.mp4

# secrets
/.secrets