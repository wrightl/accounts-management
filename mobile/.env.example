# Copy to .env.local for a machine-specific override (gitignored).
# Debug/profile builds also load .env.development automatically.
#
# Compile-time override (wins over files):
#   flutter run --dart-define-from-file=.env.local

# iOS Simulator / macOS desktop — matches `npm run dev` (port 3001).
API_BASE_URL=http://localhost:3001

# Android emulator:
# API_BASE_URL=http://10.0.2.2:3001

# Physical device (same Wi-Fi as the machine running Next.js):
# API_BASE_URL=http://192.168.x.x:3001

# Same value as the web app's NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY.
# Never put CLERK_SECRET_KEY in the mobile app.
CLERK_PUBLISHABLE_KEY=

# Optional alias if you copy keys from the web env file:
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
