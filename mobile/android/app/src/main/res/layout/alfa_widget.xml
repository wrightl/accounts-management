<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_owed_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Owed to you"
        android:textColor="#5B6075"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_owed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#171D3A"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_safe_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Safe to pay"
        android:textColor="#5B6075"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_safe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#171D3A"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/widget_updated"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#8A8FA3"
        android:textSize="10sp" />
</LinearLayout>
